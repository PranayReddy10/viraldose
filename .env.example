APP_NAME=ViralDose
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://viraldose.in
# Shared hosting only: the web root when it is not <project>/public (see deploy/bluehost)
# APP_PUBLIC_PATH=/home/USER/public_html

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# MySQL (production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=viraldose
DB_USERNAME=viraldose
DB_PASSWORD=

# Optional: old Varient database for `php artisan import:varient`
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# First admin user created by `php artisan db:seed`
ADMIN_NAME="ViralDose Editor"
ADMIN_EMAIL=admin@viraldose.in
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# "file" works everywhere; use "redis" if available for better performance
CACHE_STORE=file
CACHE_PREFIX=viraldose

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@viraldose.in"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# DigitalOcean Spaces (optional – can also be set in Admin → Settings → Storage)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
DO_SPACES_CDN_URL=
